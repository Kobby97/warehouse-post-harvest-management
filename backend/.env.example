# Copy this file to .env (or export these in your shell) before running locally.
# Defaults in application-dev.yml match docker-compose.yml, so for local dev
# with Docker Compose you often don't need to set these at all.

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=grainguard
DB_USERNAME=grainguard_user
DB_PASSWORD=grainguard_pass

JWT_SECRET=dev-only-secret-please-change-this-to-a-long-random-string-before-any-real-use
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
